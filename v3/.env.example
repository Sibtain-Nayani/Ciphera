# Copy to v3/.env for the local Docker Compose stack. Replace both placeholders.
# Generate independent values with: python -c "import secrets; print(secrets.token_hex(32))"
CIPHERA_JWT_SECRET=replace-with-a-random-64-character-hex-secret
CIPHERA_REPORT_SIGNING_KEY=replace-with-a-different-random-64-character-hex-secret

# Browser-visible API URL; Next.js bakes this into the frontend at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Browser origins permitted by the backend. Set exact HTTPS origins in deployments.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10\.0\.2\.2)(:\d+)?$|^capacitor://localhost$
FRONTEND_URL=http://localhost:3000

# Redis database 1 is reserved for authentication request limits (Compose network).
AUTH_RATE_LIMIT_REDIS_URL=redis://redis:6379/1

# Optional integrations. Leave unset unless enabled and reviewed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v3/auth/google/callback
GROQ_API_KEY=

# Optional S3-compatible storage. Local Compose uses local storage by default.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/uploads
# S3_BUCKET=ciphera-documents
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
