# ── Ciphera V3 Environment Template ──────────────────────────────────────
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# JWT Secret Key
# Generate a new random secret for local dev:
# python -c "import secrets; print(secrets.token_hex(32))"
CIPHERA_JWT_SECRET=your_generated_32_byte_hex_jwt_secret

# LLM / Groq API Key (get free key at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Database Configuration
# Local standalone default (SQLite):
DATABASE_URL=sqlite:///./data/ciphera.db
# PostgreSQL (e.g., Docker Compose):
# DATABASE_URL=postgresql://ciphera:ciphera_password@localhost:5432/ciphera_db

# Environment Mode ("development" or "production")
CIPHERA_ENV=development

# Google OAuth Credentials (optional for password auth, required for Google Login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v3/auth/google/callback

# Frontend & CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
