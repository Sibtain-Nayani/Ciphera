# Copy to v3/backend/.env for manual backend development. Replace both placeholders.
# Generate independent values with: python -c "import secrets; print(secrets.token_hex(32))"
CIPHERA_JWT_SECRET=replace-with-a-random-64-character-hex-secret
CIPHERA_REPORT_SIGNING_KEY=replace-with-a-different-random-64-character-hex-secret

# Primary SQLAlchemy database for local development; use a disposable database.
DATABASE_URL=sqlite:///./data/ciphera.db

# Required to run asynchronous redaction jobs. Start Redis and a Celery worker.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
AUTH_RATE_LIMIT_REDIS_URL=redis://localhost:6379/0

# File storage
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/uploads
# S3_BUCKET=ciphera-documents
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional integrations; configure only when intentionally enabled.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v3/auth/google/callback
FRONTEND_URL=http://localhost:3000
# GROQ_API_KEY=

# Browser security and processing bounds
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_PDF_PAGE_COUNT=100

# Transitional SQLite feature stores. Keep local paths under ignored data/.
# CIPHERA_AUDIT_DB_PATH=./data/audit.db
# CIPHERA_DB_PATH=./data/ciphera.db
